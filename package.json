{
  "name": "kitrelay",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview --host 127.0.0.1",
    "dev:cloud": "wrangler dev --port 8787",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply kitrelay --local",
    "db:remote": "wrangler d1 migrations apply kitrelay --remote"
  },
  "dependencies": {
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "wrangler": "^4.155.0"
  }
}
