{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitrelay",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kitrelay",
      "database_id": "1bbc5db1-28bc-4964-bd14-9e4f4f93b7af",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ORIGIN": "https://kitrelay.arunchandel1780.workers.dev",
  },
}
